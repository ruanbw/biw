# backend service base url, test (dev server) environment
#
# Only used as the proxy target: VITE_HTTP_PROXY=Y rewrites every request through
# /proxy-default, so the browser makes a same-origin request and the Spring side
# needs no CORS configuration.
VITE_SERVICE_BASE_URL=http://localhost:8080

# other backend service base url, test environment
VITE_OTHER_SERVICE_BASE_URL={}
